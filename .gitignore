# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.env
.venv
venv/

# Conda environments (large, reproducible via bootstrap)
envs/

# Legacy genome dir — superseded by data/core_test_data_{build}/genome/
data/genomes/

# Large binary files in core test data (tracked via manifest + provenance, not git LFS)
data/core_test_data_*/genome/*.fa
data/core_test_data_*/genome/*.fa.*
data/core_test_data_*/short_read/**/*.fastq.gz
data/core_test_data_*/long_read/**/*.fastq.gz
data/core_test_data_*/long_read/**/*.pod5
data/core_test_data_*/long_read/**/*.fast5
data/core_test_data_*/pipeline_outputs/**/*.bam
data/core_test_data_*/pipeline_outputs/**/*.bai
data/core_test_data_*/pipeline_outputs/**/*.sam
data/core_test_data_*/pipeline_outputs/**/*.vcf

# Raw source reads cache — eliminated; reads are now stream-subsetted directly
data/sources/

# Old test_data dir — superseded by data/core_test_data_{build}/
data/test_data/

# Generated data artifacts (manifest, provenance, sample metadata)
# Regenerated by the agent; do not track in git
data/core_test_data_*/manifest.yaml
data/core_test_data_*/**/*_provenance.yaml
data/core_test_data_*/**/*_sample_meta.yaml

# Generated Docker artifacts (large)
docker_images/*/

# Pipeline specs and HTML reports are generated artifacts — not tracked in git
env_reports/

# Workspace state (in-progress pipeline drafts; W1 background freeze job ephemera).
# These used to live in env_reports/ but were split out in batch3 so env_reports/
# stays deliverables-only. Both are runtime-generated; nothing in them belongs
# in the repo.
data/pipeline_drafts/
data/jobs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Stress-test workspaces (data/{tool}_stress_test_data/, data/{tool}_test_data/
# created by the agent during a stress campaign — not committed)
data/*_stress_test_data/
data/*_test_data/

# Per-run cluster output dirs — created by run_step_on_cluster + production
# fetches into data/{workflow}_outputs/. Local-only.
data/*_outputs/

# One-shot driver scripts (per-session validation drivers; the integration suite
# is the durable surface — drivers are throwaway).
data/_drivers/

# Claude Code session lock — runtime sentinel, regenerated per session.
.claude/scheduled_tasks.lock

# The agent's command-and-control file — contains real cluster hostnames,
# usernames, and paths. NEVER COMMIT. See agent/skills/projects_access.yaml.example
# for the tracked template (generic placeholders only).
#
# The glob covers the sidecars too: scripts/configure.py writes a .bak on every
# save, and a backup of a secret is a secret. The tracked template lives under
# agent/skills/, so nothing at the repo root is meant to be committed under this
# name.
/projects_access.yaml*

# Local submission manifests written by submit_workflow_job — per-user,
# per-run cluster job records. The user follows these to find a submitted
# job after the agent has been cut off. Local-only by default; the user
# can untrack a specific manifest if they want to commit it as audit trail.
/job_submissions/

# Transfer manifests (one per upload/download, replay-state)
transfer_history/

# outcome-model coverage artifacts (transient; measured, not authored)
.coverage
.coverage.*
coverage.json

# bootstrapped / downloaded test data (regenerated by setup_core_test_data.sh,
# dorado models, per-pipeline fixtures) — never versioned
data/

# Store locks — advisory flock sentinels (agent/skills/store_lock.py), runtime only.
*.lock

# The agent's own runtime env — created per-clone by scripts/setup.sh; the
# launcher (start_mcp_server.sh) and bootstrap wrapper resolve it by this path.
.conda_runtime/

# Private miniforge — installed by scripts/setup.sh only on machines with no
# conda anywhere (with consent). Repo-local, no shell integration.
.miniforge/
