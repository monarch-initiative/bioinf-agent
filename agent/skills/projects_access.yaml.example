# ═══════════════════════════════════════════════════════════════════════════
#   projects_access.yaml — the agent's COMMAND-AND-CONTROL file.
# ═══════════════════════════════════════════════════════════════════════════
#
# The agent reads this on every call; never writes it.
#
# Convention used throughout this file:
#   - Every key below is from the agent's SCHEMA LANGUAGE (fixed vocabulary).
#   - Values you supply are YOUR strings (names, paths, descriptions).
#   - You never have to guess which key is "mine" vs "yours" — all keys are
#     mine; everything to the right of `:` is yours.
#
# ─── Schema (the fixed vocabulary) ─────────────────────────────────────────
#
#   compute_envs[]:                     a list of compute environments
#     - name                            YOUR label for this env (referenced by projects below)
#       type                            one of: ssh | local
#       host                            hostname                       (ssh only)
#       user                            username                       (ssh only; ssh-agent auth, no creds stored)
#       container_upload_target         a directory-access block, or null:
#         path                          absolute path on the env
#         permissions                   list of permission tokens — MUST include
#                                       `upload`; may also include `file_name_only`
#                                       (so the agent can see what's been uploaded)
#         description                   free text
#
#   projects[]:                         a list of projects
#     - name                            YOUR label for this project
#       description                     free text
#       compute_env_access[]:           one block per compute_env this project uses
#         - compute_env                 references a compute_envs[].name above
#           directories[]:              the dir-access blocks this project gets on that env
#             - path                    absolute path on the env
#               permissions             list of permission tokens
#               description             free text
#
# ─── Permission tokens (v0) ────────────────────────────────────────────────
#
#   file_name_only    list a dir's IMMEDIATE contents (path/size/mtime/type).
#                     ONE LEVEL ONLY — subdir interiors require their own entry.
#
#   upload            write NEW files. Never overwrites. (Primitive not yet
#                     wired; declaring it today is a no-op.)
#
#   none              explicit deny (the default for any path not listed).
#
# A directory can carry MULTIPLE permissions — `permissions:` is a LIST.
#
# ═══════════════════════════════════════════════════════════════════════════


compute_envs:

  # ─────────────────────────────────────────────────────────────────────────
  # SSH MODE — a remote cluster the agent reaches over ssh.
  # ─────────────────────────────────────────────────────────────────────────
  - name: cluster                                # YOUR label
    type: ssh
    host: hpc-login.example.edu
    user: alice                                  # ssh-agent handles auth; NO creds stored

    container_upload_target:
      path: /scratch/alice/containers/
      permissions: [upload]
      description: "where the agent uploads .sif container images for this env"

  # ─────────────────────────────────────────────────────────────────────────
  # LOCAL MODE — this laptop / wherever the agent process runs.
  # `host` and `user` don't apply for local mode (omit them).
  # ─────────────────────────────────────────────────────────────────────────
  - name: laptop
    type: local

    container_upload_target: null                # set to null to disable container upload on this env


# ═══════════════════════════════════════════════════════════════════════════
#   projects — bind a project name to (compute env(s) + per-env dir access).
# ═══════════════════════════════════════════════════════════════════════════

projects:

  # ─── Single-env project on the cluster ───────────────────────────────────
  - name: wgs_proj
    description: "WGS analysis on the cluster"
    compute_env_access:

      - compute_env: cluster                     # references compute_envs[].name above
        directories:

          - path: /scratch/alice/wgs_proj/
            permissions: [file_name_only]
            description: "raw + processed reads, inventory only"

          - path: /scratch/alice/wgs_proj_scratch/
            permissions: [file_name_only, upload]    # MULTIPLE permissions on the same dir
            description: "scratch space — list AND upload"

          - path: /scratch/alice/wgs_proj_outputs/
            permissions: [upload]                # upload-only — invisible to snapshot
            description: "agent-staged outputs"

  # ─── Single-env project on the laptop (the envs/ catalog you drove e2e) ──
  - name: envs_catalog
    description: "This repo's envs/ catalog + tool-discovery views"
    compute_env_access:

      - compute_env: laptop
        directories:

          - path: /Users/alice/code/bioinf_agent/envs/
            permissions: [file_name_only]
            description: "which envs are bootstrapped"

          - path: /Users/alice/code/bioinf_agent/envs/bioinf_core_tools/bin/
            permissions: [file_name_only]
            description: "tool-discovery view: samtools, bcftools, ..."

  # ─── Multi-env project — same project spans two envs ────────────────────
  - name: wgs_with_mirror
    description: "WGS project — cluster-of-record + local mirror"
    compute_env_access:

      - compute_env: cluster
        directories:
          - path: /scratch/alice/wgs_proj/
            permissions: [file_name_only]
            description: "data on the cluster"

      - compute_env: laptop
        directories:
          - path: /Users/alice/code/bioinf_agent/data/wgs_local_mirror/
            permissions: [file_name_only]
            description: "local mirror for offline iteration"
